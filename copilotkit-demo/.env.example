# Existing Greenlighting backend is proxied by Vite to http://127.0.0.1:8000.

# Optional: run the Copilot chat through the OpenAI-backed local runtime.
# Start it with: npm run copilot:runtime
VITE_COPILOTKIT_RUNTIME_URL=http://127.0.0.1:4010/api/copilotkit
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Alternative: reuse the existing Greenlighting Agent env file.
# Set this to your local greenlighting-agent/.env path when you do not want
# to duplicate ANTHROPIC_API_KEY in this demo folder.
GREENLIGHT_ENV_FILE=/path/to/greenlighting-agent/.env
ANTHROPIC_API_KEY=sk-ant-your-key-here
MODEL_NAME=claude-sonnet-4-5-20250929

# Optional runtime server overrides.
COPILOT_RUNTIME_HOST=127.0.0.1
COPILOT_RUNTIME_PORT=4010
COPILOT_RUNTIME_BASE_PATH=/api/copilotkit
